{
  "name": "quick-note-md",
  "displayName": "QuickNoteMD",
  "description": "Markdownファイルで管理するローカルIssueサイドバー",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazumi38/quick-note-md.git"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:quick-note-md.issues",
    "onCommand:quick-note-md.newIssue",
    "onCommand:quick-note-md.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quick-note-md",
          "title": "QuickNoteMD",
          "icon": "media/note.svg"
        }
      ]
    },
    "views": {
      "quick-note-md": [
        {
          "id": "quick-note-md.issues",
          "name": "Issues",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "quick-note-md.issues",
        "contents": "Issueはまだありません。[Issueを作成](command:quick-note-md.newIssue)"
      }
    ],
    "commands": [
      {
        "command": "quick-note-md.newIssue",
        "title": "QuickNoteMD: 新規Issue",
        "icon": "$(add)"
      },
      {
        "command": "quick-note-md.refresh",
        "title": "QuickNoteMD: Issue一覧を更新",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quick-note-md.newIssue",
          "when": "view == quick-note-md.issues",
          "group": "navigation@1"
        },
        {
          "command": "quick-note-md.refresh",
          "when": "view == quick-note-md.issues",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "compile:webview": "webpack --config-name issue-webview",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "test:e2e": "npm run compile && tsc -p e2e/tsconfig.json --noEmit && playwright test --config e2e/playwright.config.ts",
    "test:e2e:guide": "npm run compile && tsc -p e2e/tsconfig.json --noEmit && playwright test --config e2e/playwright.config.ts e2e/manual-guide.spec.ts --grep @guide",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src e2e",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "markdown-it": "^14.3.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.6"
  }
}
